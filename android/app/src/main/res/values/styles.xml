<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:editTextBackground">@android:color/transparent</item>
        <item name="android:windowBackground">@color/arise_bg</item>
        <item name="android:statusBarColor">@color/arise_bg</item>
        <item name="android:navigationBarColor">@color/arise_bg</item>
    </style>

    <!-- Wall screen theme — fullscreen, no action bar -->
    <style name="WallTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowBackground">@color/wall_bg</item>
    </style>
</resources>
