{
  "extends": "@react-native/typescript-config/tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@screens/*":    ["src/screens/*"],
      "@services/*":   ["src/services/*"],
      "@store/*":      ["src/store/*"],
      "@utils/*":      ["src/utils/*"],
      "@components/*": ["src/components/*"],
      "@theme/*":      ["src/theme/*"]
    }
  },
  "exclude": ["node_modules", "android", "ios"]
}
